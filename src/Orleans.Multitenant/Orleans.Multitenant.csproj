<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <AnalysisLevel>preview-All</AnalysisLevel>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>
    
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageId>Orleans.Multitenant</PackageId>
        <!-- To release a new version, follow docs/releasing.md. The package version, file version, informational version and release tag are derived from this version;
             for a prerelease, add e.g. <VersionSuffix>rc1</VersionSuffix> -->
        <VersionPrefix>5.0.1</VersionPrefix>
        <!-- The assembly version only changes with the major version, as the .NET library guidance recommends -->
        <AssemblyVersion>$(VersionPrefix.Substring(0, $(VersionPrefix.IndexOf('.')))).0.0.0</AssemblyVersion>
        <FileVersion>$(VersionPrefix)</FileVersion>
        <Title>Orleans Multitenant</Title>
        <Description>Secure, flexible tenant separation for Microsoft Orleans 10</Description>
        <Authors>VincentH.NET</Authors>
        <Company>InnoWvate.NET</Company>
        <Copyright>Copyright © InnoWvate.NET</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/VincentH-Net/Orleans.Multitenant</PackageProjectUrl>
        <PackageIcon>CSharp-Toolkit-Icon.png</PackageIcon>
        <PackageReadmeFile>Readme.md</PackageReadmeFile>
        <PackageReleaseNotes>See source repository for release notes</PackageReleaseNotes>
        <RepositoryUrl>https://github.com/VincentH-Net/Orleans.Multitenant</RepositoryUrl>
        <PackageTags>multitenant;multi-tenant;tenant;tenant separation;separation;Orleans;Orleans 10;Microsoft Orleans;InnoWvate.NET</PackageTags>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- Enable Source Link -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>

        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>
    <ItemGroup>
        <None Include="CSharp-Toolkit-Icon.png" Pack="true" PackagePath="\" />
        <None Include="$(IntermediateOutputPath)Readme.md" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <!-- The package readme is generated from Readme.md, so that its release notes link always matches Version -->
    <Target Name="GeneratePackageReadme" BeforeTargets="BeforeBuild">
        <PropertyGroup>
            <!-- The tag of the GitHub release for Version, e.g. 5-0-1 or 5-0-1-rc1. The release notes link in the package readme is generated from this -->
            <ReleaseTag>$(Version.Replace('.', '-'))</ReleaseTag>
            <PackageReadmeTemplate>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/Readme.md'))</PackageReadmeTemplate>
        </PropertyGroup>
        <Error Condition="!$(PackageReadmeTemplate.Contains('{ReleaseTag}'))"
               Text="Readme.md must link to the release notes with the {ReleaseTag} placeholder; do not write a release tag in Readme.md, it is generated from Version" />
        <WriteLinesToFile File="$(IntermediateOutputPath)Readme.md"
                          Lines="$([MSBuild]::Escape($(PackageReadmeTemplate.Replace('{ReleaseTag}', '$(ReleaseTag)'))))"
                          Overwrite="true" WriteOnlyWhenDifferent="true" />
    </Target>

    <ItemGroup>
		<PackageReference Include="Microsoft.Orleans.Runtime" Version="10.4.0" />
		<PackageReference Include="Microsoft.Orleans.Sdk" Version="10.4.0" />
		<PackageReference Include="Microsoft.Orleans.Streaming" Version="10.4.0" />
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.111" PrivateAssets="All" />
	</ItemGroup>

</Project>
