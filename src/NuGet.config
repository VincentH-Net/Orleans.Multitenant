<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<packageSources>
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />

		<!-- Use the local-built version of Orleans.Multitenant NuGet: a Release build of the library puts the package in this folder.
		     The folder is kept in git with a .gitkeep file, so that restore does not fail when the library has not been built yet -->
		<add key="multitenant-local" value="Orleans.Multitenant/bin/Release" />
	</packageSources>
</configuration>
